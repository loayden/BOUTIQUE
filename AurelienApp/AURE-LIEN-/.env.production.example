# Production deployment template. Copy these values into Vercel/hosting secrets.
# Never commit a real .env.production file.

AURELIEN_AUTH_SECRET=replace-with-a-long-random-production-secret
AURELIEN_ADMIN_EMAIL=admin@example.com
AURELIEN_ADMIN_PASSWORD=replace-with-a-strong-production-admin-password
AURELIEN_MONGODB_URI=replace-with-your-mongodb-atlas-uri
AURELIEN_MONGODB_DB=aurelien
AURELIEN_IMAGE_STORAGE=mongodb
AURELIEN_ENABLE_EXPERIMENTAL_ENDPOINTS=false
AURELIEN_API_BASE_URL=https://your-production-domain.example/api
AURELIEN_STATIC_CONTENT_BASE_URL=https://your-production-domain.example
