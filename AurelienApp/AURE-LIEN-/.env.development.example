# Local development template. Copy to .env.local or .env.development.
# Values here are placeholders and are safe to commit.

AURELIEN_AUTH_SECRET=dev-only-replace-with-a-long-random-secret
AURELIEN_ADMIN_EMAIL=admin@example.com
AURELIEN_ADMIN_PASSWORD=change-me-local-admin-password
AURELIEN_MONGODB_URI=mongodb://127.0.0.1:27017
AURELIEN_MONGODB_DB=aurelien
AURELIEN_IMAGE_STORAGE=mongodb
AURELIEN_ENABLE_EXPERIMENTAL_ENDPOINTS=false
AURELIEN_UPLOAD_DIR=public/uploads/admin
AURELIEN_PUBLIC_UPLOAD_BASE_URL=http://127.0.0.1:3104/uploads/admin
AURELIEN_API_BASE_URL=http://127.0.0.1:3104/api
AURELIEN_STATIC_CONTENT_BASE_URL=http://127.0.0.1:3104
AURELIEN_SMOKE_BASE_URL=http://127.0.0.1:3104/api
