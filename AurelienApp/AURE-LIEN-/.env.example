# Shared backend configuration template.
# Do not put real production values in this file.

AURELIEN_AUTH_SECRET=replace-with-a-long-random-secret
AURELIEN_ADMIN_EMAIL=admin@example.com
AURELIEN_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AURELIEN_MONGODB_URI=replace-with-your-mongodb-atlas-uri
AURELIEN_MONGODB_DB=aurelien
AURELIEN_IMAGE_STORAGE=mongodb
AURELIEN_UPLOAD_DIR=/var/lib/aurelien/uploads
AURELIEN_PUBLIC_UPLOAD_BASE_URL=https://replace-with-your-api-domain.com/uploads/admin
AURELIEN_ENABLE_EXPERIMENTAL_ENDPOINTS=false
AURELIEN_API_BASE_URL=https://replace-with-your-api-domain.com/api
AURELIEN_STATIC_CONTENT_BASE_URL=https://replace-with-your-api-domain.com
