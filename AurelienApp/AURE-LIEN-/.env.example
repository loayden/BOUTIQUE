AURELIEN_AUTH_SECRET=replace-with-a-long-random-secret
AURELIEN_ADMIN_EMAIL=replace-with-your-admin-email
AURELIEN_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AURELIEN_MONGODB_URI=replace-with-your-mongodb-uri
AURELIEN_MONGODB_DB=aurelien
AURELIEN_IMAGE_STORAGE=mongodb
AURELIEN_UPLOAD_DIR=/var/lib/aurelien/uploads
AURELIEN_PUBLIC_UPLOAD_BASE_URL=https://replace-with-your-api-domain.com/uploads/admin
